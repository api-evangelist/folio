{
 "openapi": "3.0.0",
 "info": {
  "title": "edge-fqm API",
  "version": "v1",
  "description": "edge-fqm API"
 },
 "servers": [
  {
   "url": "https://folio-etesting-snapshot-edge.ci.folio.org/"
  }
 ],
 "paths": {
  "/entity-types": {
   "get": {
    "operationId": "getEntityTypeSummary",
    "tags": [
     "entityTypes"
    ],
    "description": "Get names for a list of entity type ids.",
    "parameters": [
     {
      "$ref": "#/components/parameters/entity-type-ids"
     },
     {
      "$ref": "#/components/parameters/include-inaccessible"
     },
     {
      "$ref": "#/components/parameters/include-all"
     }
    ],
    "responses": {
     "200": {
      "description": "Entity type summaries",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EntityTypeSummaries"
        }
       }
      }
     },
     "4XX": {
      "$ref": "#/components/responses/badRequestResponse"
     }
    }
   }
  }
 },
 "components": {
  "parameters": {
   "entity-type-id": {
    "name": "entity-type-id",
    "in": "path",
    "required": true,
    "description": "Name of the derived table",
    "schema": {
     "type": "string",
     "format": "UUID"
    }
   },
   "entity-type-ids": {
    "name": "ids",
    "in": "query",
    "required": false,
    "description": "List of entity type ids",
    "schema": {
     "type": "array",
     "items": {
      "type": "string",
      "format": "UUID"
     }
    }
   },
   "include-inaccessible": {
    "name": "includeInaccessible",
    "in": "query",
    "required": false,
    "description": "Include inaccessible entity types in the result",
    "schema": {
     "type": "boolean"
    }
   },
   "include-all": {
    "name": "includeAll",
    "in": "query",
    "required": false,
    "description": "Include all entity types (including private ones) in the result",
    "schema": {
     "type": "boolean"
    }
   }
  },
  "schemas": {
   "contents": {
    "type": "array",
    "items": {
     "$ref": "#/components/schemas/contentItem"
    }
   },
   "contentItem": {
    "type": "object",
    "additionalProperties": {
     "type": "object"
    }
   },
   "entityTypeSummaries": {
    "$ref": "#/components/schemas/EntityTypeSummaries"
   },
   "EntityTypeSummary": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Entity Type Summary",
    "type": "object",
    "properties": {
     "id": {
      "description": "Entity type id",
      "type": "string",
      "format": "UUID"
     },
     "label": {
      "description": "Entity type label",
      "type": "string"
     },
     "isCustom": {
      "description": "If this entity type is a custom entity type",
      "type": "boolean"
     },
     "crossTenantQueriesEnabled": {
      "description": "Indicates if this entity type supports cross-tenant queries",
      "type": "boolean",
      "default": false
     },
     "missingPermissions": {
      "description": "List of missing permissions",
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "createdAt": {
      "description": "[custom only] The creation timestamp of the entity type",
      "type": "string",
      "format": "date-time"
     },
     "updatedAt": {
      "description": "[custom only] The last update timestamp of the entity type",
      "type": "string",
      "format": "date-time"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "label",
     "isCustom"
    ]
   },
   "EntityTypeSummaries": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "Entity Type Summary List",
    "type": "object",
    "properties": {
     "entityTypes": {
      "description": "Entity type list",
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/EntityTypeSummary"
      }
     },
     "_version": {
      "description": "Current FQL version (same as /fqm/version returns)",
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "entityTypes",
     "_version"
    ]
   }
  },
  "responses": {
   "badRequestResponse": {
    "description": "Invalid request; see mod-fqm-manager API documentation for response details"
   }
  }
 }
}