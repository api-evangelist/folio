      }
     }
    }
   }
  },
  "schemas": {
   "uuid": {
    "$schema": "http://json-schema.org/draft-04/schema#",
    "description": "A universally unique identifier (UUID), this is a 128-bit number used to identify a record and is shown in hex with dashes, for example 6312d172-f0cf-40f6-b27d-9fa8feaf332f; the UUID version must be from 1-5; see https://dev.folio.org/guides/uuids/",
    "type": "string",
    "pattern": "^[a-fA-F0-9]{8}-[a-fA-F0-9]{4}-[1-5][a-fA-F0-9]{3}-[89abAB][a-fA-F0-9]{3}-[a-fA-F0-9]{12}$"
   },
   "ServicePoint": {
    "description": "Service point associated to the reading room",
    "type": "object",
    "properties": {
     "value": {
      "description": "A unique service point identifier",
      "type": "string",
      "format": "UUID"
     },
     "label": {
      "description": "Name of the service point",
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "value",
     "label"
    ]
   },
   "common_uuid": {
    "type": "string",
    "format": "uuid"
   },
   "Metadata": {
    "type": "object",
    "title": "Metadata",
    "description": "Metadata about creation and changes to records",
    "properties": {
     "createdDate": {
      "type": "string",
      "description": "Date and time when the record was created"
     },
     "createdByUserId": {
      "$ref": "#/components/schemas/common_uuid",
      "description": "ID of the user who created the record"
     },
     "updatedDate": {
      "type": "string",
      "description": "Date and time when the record was last updated"
     },
     "updatedByUserId": {
      "$ref": "#/components/schemas/common_uuid",
      "description": "ID of the user who last updated the record"
     }
    }
   },
   "ReadingRoom": {
    "description": "Reading room",
    "type": "object",
    "properties": {
     "id": {
      "description": "A unique reading room identifier",
      "type": "string",
      "format": "UUID"
     },
     "name": {
      "description": "Name of the reading room",
      "type": "string",
      "minLength": 1
     },
     "isPublic": {
      "description": "A flag to determine whether a reading room is public or not",
      "type": "boolean"
     },
     "servicePoints": {
      "description": "Service points which are associated to Reading Room",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
       "$ref": "#/components/schemas/ServicePoint"
      }
     },
     "metadata": {
      "type": "object",
      "$ref": "#/components/schemas/Metadata"
     }
    },
    "required": [
     "id",
     "name",
     "isPublic",
     "servicePoints"
    ]
   },
   "ReadingRoomCollection": {
    "type": "object",
    "description": "A JSON schema for the readingroom Collection",
    "properties": {
     "readingRooms": {
      "type": "array",
      "description": "The list of readingroom",
      "items": {
       "$ref": "#/components/schemas/ReadingRoom"
      }
     },
     "totalRecords": {
      "type": "integer"
     }
    },
    "additionalProperties": false,
    "required": [
     "readingRooms",
     "totalRecords"
    ]
   },
   "Parameter": {
    "description": "List of key/value parameters of an error",
    "type": "object",
    "properties": {
     "key": {
      "type": "string",
      "minLength": 1
     },
     "value": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "key"
    ]
   },
   "Parameters": {
    "description": "List of key/value parameters of an error",
    "type": "array",
    "items": {
     "$ref": "#/components/schemas/Parameter"
    },
    "additionalProperties": false
   },
   "Error": {
    "description": "An error",
    "type": "object",
    "properties": {
     "message": {
      "type": "string",
      "minLength": 1,
      "description": "Error message text"
     },
     "type": {
      "type": "string",
      "description": "Error message type"
     },
     "code": {
      "type": "string",
      "description": "Error message code"
     },
     "parameters": {
      "description": "Error message parameters",
      "$ref": "#/components/schemas/Parameters"
     }
    },
    "additionalProperties": false,
    "required": [
     "message"
    ]
   },
   "Errors": {
    "description": "A set of errors",
    "type": "object",
    "properties": {
     "errors": {
      "description": "List of errors",
      "type": "array",
      "items": {
       "type": "object",
       "$ref": "#/components/schemas/Error"
      }
     },
     "total_records": {
      "description": "Total number of errors",
      "type": "integer"
     }
    },
    "additionalProperties": false
   },
   "AccessLog": {
    "description": "Access log",
    "type": "object",
    "properties": {
     "id": {
      "description": "A unique access log identifier",
      "type": "string",
      "format": "UUID"
     },
     "readingRoomId": {
      "description": "Id of a reading room",
      "type": "string",
      "format": "UUID"
     },
     "readingRoomName": {
      "description": "Name of a reading room",
      "type": "string"
     },
     "servicePointId": {
      "description": "Id of a servicePoint which is associated with the reading room",
      "type": "string",
      "format": "UUID"
     },
     "userId": {
      "description": "Id of a user who allows or denies the user from accessing the reading room",
      "type": "string",
      "format": "UUID"
     },
     "patronId": {
      "description": "Id of a user who wants to access the reading room",
      "type": "string",
      "format": "UUID"
     },
     "action": {
      "description": "A field to determine whether a user is allowed to a reading room or not",
      "type": "string",
      "enum": [
       "ALLOWED",
       "DENIED"
      ]
     }
    }
   },
   "AccessLogCollection": {
    "type": "object",
    "description": "A JSON schema for the accessLog Collection",
    "properties": {
     "accessLogs": {
      "type": "array",
      "description": "The list of accessLog entries",
      "items": {
       "$ref": "#/components/schemas/AccessLog"
      }
     },
     "totalRecords": {
      "type": "integer"
     }
    },
    "additionalProperties": false,
    "required": [
     "accessLogs",
     "totalRecords"
    ]
   }
  },
  "parameters": {
   "readingRoomId": {
    "in": "path",
    "name": "readingRoomId",
    "schema": {
     "$ref": "#/components/schemas/common_uuid"
    },
    "required": true,
    "description": "Id of the reading room"
   },
   "cqlQuery": {
    "name": "query",
    "in": "query",
    "schema": {
     "type": "string",
     "default": "cql.allRecords=1"
    },
    "required": false,
    "description": "A query expressed as a CQL string"
   },
   "offset": {
    "name": "offset",
    "in": "query",
    "schema": {
     "type": "integer",
     "default": 0,
     "minimum": 0,
     "maximum": 2147483647
    },
    "required": false,
    "description": "Skip over a number of elements by specifying an offset value for the query"
   },
   "limit": {
    "name": "limit",
    "in": "query",
    "schema": {
     "type": "integer",
     "default": 1000,
     "minimum": 1,
     "maximum": 2147483647
    },
    "required": false,
    "description": "Limit the number of elements returned in the response"
   },
   "includeDeleted": {
    "name": "includeDeleted",
    "in": "query",
    "schema": {
     "type": "boolean",
     "default": false
    },
    "required": false,
    "description": "Flag to include the deleted records"
   }
  }
 }
