 },
 "components": {
  "parameters": {
   "tenant-id": {
    "name": "tenantId",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string"
    },
    "example": "diku"
   },
   "patron-request-id": {
    "name": "patronRequestId",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string"
    },
    "example": "3c3f172c-6874-4c56-88e1-2350a3d90320"
   },
   "id": {
    "name": "id",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string"
    }
   }
  },
  "schemas": {
   "parameter": {
    "description": "List of key/value parameters of an error",
    "type": "object",
    "properties": {
     "key": {
      "description": "Parameter key",
      "type": "string"
     },
     "value": {
      "description": "Parameter value",
      "type": "string"
     }
    },
    "example": {
     "name": "field",
     "value": "must not be empty"
    }
   },
   "error": {
    "description": "An error",
    "type": "object",
    "properties": {
     "message": {
      "type": "string",
      "description": "Error message text"
     },
     "type": {
      "type": "string",
      "description": "Error message type"
     },
     "code": {
      "type": "string",
      "description": "Error message code"
     },
     "parameters": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/parameter"
      }
     }
    },
    "example": {
     "message": "Entity already exists.",
     "type": "EntityExistsException",
     "code": "entity_exists",
     "parameters": [
      {
       "name": "id",
       "value": "5ac63bf6-20e4-4449-9efd-01dbca051acf"
      }
     ]
    }
   },
   "errors": {
    "description": "A set of errors",
    "type": "object",
    "properties": {
     "errors": {
      "description": "List of errors",
      "x-field-extra-annotation": "@com.fasterxml.jackson.annotation.JsonInclude(com.fasterxml.jackson.annotation.JsonInclude.Include.NON_NULL)",
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/error"
      }
     },
     "total_records": {
      "description": "Total number of errors",
      "type": "integer"
     }
    },
    "example": {
     "errors": [
      {
       "message": "Error Message Text",
       "type": "ServiceException",
       "code": "error_code",
       "parameters": [
        {
         "name": "cause",
         "value": "Service exception cause"
        }
       ]
      }
     ],
     "total_records": 1
    }
   },
   "TestDocumentDeliveryOffer": {
    "type": "object",
    "properties": {
     "systemId": {
      "type": "string",
      "description": "The id of the institution an order is to be placed for"
     },
     "url": {
      "type": "string",
      "description": "The url of the document delivery system"
     },
     "privateKey": {
      "type": "string",
      "description": "The private key to use"
     },
     "offerReference": {
      "type": "string",
      "description": "The reference for this document"
     },
     "documentTitle": {
      "type": "string",
      "description": "The title for this offer"
     },
     "pin": {
      "type": "string",
      "description": "The pin the user has to use to access the document"
     },
     "documentSecurityLevel": {
      "type": "string",
      "description": "The document security level",
      "enum": [
       "DRM",
       "MARKED",
       "NONE",
       "SECURE"
      ]
     },
     "offerType": {
      "type": "string",
      "description": "The type of offer being made",
      "enum": [
       "DOCUMENT_STREAM",
       "URL"
      ]
     },
     "attestationLevel": {
      "type": "string",
      "description": "The attestation level",
      "enum": [
       "SIMPLE"
      ]
     },
     "patronEmail": {
      "type": "string",
      "description": "The patron's email"
     },
     "rawSourceMimeType": {
      "type": "string",
      "description": "The mime type for the document"
     },
     "workflow": {
      "type": "string",
      "description": "The workflow we want this offer to follow"
     },
     "file": {
      "type": "string",
      "description": "The file to be uploaded, either this property of the rawSourceUrl property must be specified",
      "format": "binary"
     }
    },
    "required": [
     "systemId",
     "url",
     "privateKey",
     "offerReference",
     "pin",
     "documentSecurityLevel",
     "attestationLevel"
    ]
   },
   "TestDocumentDeliveryRegister": {
    "type": "object",
    "properties": {
     "systemCode": {
      "type": "string",
      "description": "The code of the institution we want to register"
     },
     "url": {
      "type": "string",
      "description": "The url of the document delivery system"
     },
     "name": {
      "type": "string",
      "description": "The name of the institution we are registering for"
     },
     "attestationLevel": {
      "type": "string",
      "description": "The attestation level",
      "enum": [
       "SIMPLE"
      ]
     }
    },
    "required": [
     "systemCode",
     "url",
     "name",
     "attestationLevel"
    ]
   }
  },
  "responses": {
   "BadRequest": {
    "description": "Bad Request",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/errors"
      },
      "example": {
       "errors": [
        {
         "code": "validation",
         "type": "BadRequest",
         "message": "The input provided is invalid.",
         "parameters": [
          {
           "name": "field",
           "value": "must not be empty"
          }
         ]
        }
       ],
       "total_records": 1
      }
     }
    }
   },
   "InternalServerError": {
    "description": "Internal Server Error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/errors"
      },
      "example": {
       "errors": [
        {
         "code": "service",
         "type": "InternalServerErrorException",
         "message": "Unknown Service Exception"
        }
       ],
       "total_records": 1
      }
     }
    }
   },
   "NotFound": {
    "description": "Resource Not Found",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/errors"
      },
      "example": {
       "errors": [
        {
         "code": "not_found",
         "type": "EntityNotFoundException",
         "message": "Entity is not found.",
         "parameters": [
          {
           "name": "id",
           "value": "5ac63bf6-20e4-4449-9efd-01dbca051acf"
          }
         ]
        }
       ],
       "total_records": 1
      }
     }
    }
   }
  }
 }
}