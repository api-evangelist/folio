{
 "openapi": "3.0.3",
 "info": {
  "title": "Edge ILL FOLIO API",
  "description": "Edge API that proxies external client requests to the FOLIO mod-ill module.\nEndpoints mirror the mod-ill `ill` interface as declared in its module descriptor.\n",
  "version": "1.0.0"
