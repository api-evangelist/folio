{
 "openapi": "3.0.0",
 "info": {
  "title": "Settings",
  "version": "v1"
 },
 "paths": {
  "/base-url": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-tenant"
    }
   ],
   "get": {
    "description": "Get the base URL of the front-end user interface.",
    "operationId": "getBaseUrl",
    "responses": {
     "200": {
      "description": "Front-end user interface URL without tailing slash",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/baseUrl"
        },
        "example": {
         "baseUrl": "https://folio.example.com"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "put": {
    "description": "Set the base URL of the front-end user interface.",
    "operationId": "setBaseUrl",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/baseUrl"
       },
       "example": {
        "baseUrl": "https://folio.example.com"
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Base URL updated"
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  },
  "/locale": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-tenant"
    }
   ],
   "get": {
    "description": "Get the locale settings for the tenant.",
    "operationId": "getLocale",
    "responses": {
     "200": {
      "description": "The locale settings",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/locale"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "put": {
    "description": "Set the locale settings for the tenant.",
    "operationId": "setLocale",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/locale"
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Locale settings updated"
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  },
  "/tenant-addresses": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-tenant"
    },
    {
     "$ref": "#/components/parameters/query"
    },
    {
     "$ref": "#/components/parameters/limit"
    },
    {
     "$ref": "#/components/parameters/offset"
    }
   ],
   "get": {
    "description": "Get tenant addresses",
    "operationId": "getTenantAddresses",
    "responses": {
     "200": {
      "description": "The tenant addresses",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/tenantAddresses"
        }
       }
      }
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "post": {
    "description": "Create tenant address",
    "operationId": "createTenantAddress",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/tenantAddress"
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Tenant address created",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/tenantAddress"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "422": {
      "description": "Tenant address validation error"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  },
  "/tenant-addresses/{id}": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-tenant"
    },
    {
     "in": "path",
     "name": "id",
     "required": true,
     "description": "Tenant address identifier",
     "schema": {
      "type": "string",
      "format": "uuid"
     }
    }
   ],
   "get": {
    "description": "Get tenant address by id",
    "operationId": "getTenantAddress",
    "responses": {
     "200": {
      "description": "The tenant address",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/tenantAddress"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "put": {
    "description": "Update tenant address",
    "operationId": "updateTenantAddress",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/tenantAddress"
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Tenant address updated"
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "422": {
      "description": "Tenant address validation error"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "delete": {
    "description": "Delete tenant address",
    "operationId": "deleteTenantAddress",
    "responses": {
     "204": {
      "description": "Tenant address deleted"
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  },
  "/settings/entries": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-permissions"
    },
    {
     "$ref": "#/components/parameters/okapi-tenant"
    },
    {
     "$ref": "#/components/parameters/okapi-token"
    },
    {
     "$ref": "#/components/parameters/okapi-url"
    },
    {
     "$ref": "#/components/parameters/okapi-user"
    },
    {
     "$ref": "#/components/parameters/limit"
    },
    {
     "$ref": "#/components/parameters/offset"
    },
    {
     "$ref": "#/components/parameters/query"
    }
   ],
   "get": {
    "description": "Get settings with optional CQL query. If X-Okapi-Permissions includes mod-settings.global.read.SCOPE then settings without a userId are returned. If X-Okapi-Permissions includes mod-settings.users.read.SCOPE then settings with a userId are returned. If X-Okapi-Permissions includes mod-settings.owner.read.SCOPE then settings with userId = current-user are returned.\n",
    "operationId": "getSettings",
    "responses": {
     "200": {
      "description": "Setting entries",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/entries"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "post": {
    "description": "Create setting entry. If X-Okapi-Permissions includes mod-settings.global.write.SCOPE, then a setting without a userId may be created. If X-Okapi-Permissions includes mod-settings.users.write.SCOPE, then a setting with a userId may be created. If X-Okapi-Permissions includes mod-settings.owner.write.SCOPE, then a setting with userId = current-user may be created.\n",
    "operationId": "postSetting",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/entry"
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Setting created"
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "403": {
      "$ref": "#/components/responses/trait_403"
     },
     "413": {
      "$ref": "#/components/responses/trait_413"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  },
  "/settings/entries/{id}": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-permissions"
    },
    {
     "$ref": "#/components/parameters/okapi-tenant"
    },
    {
     "$ref": "#/components/parameters/okapi-token"
    },
    {
     "$ref": "#/components/parameters/okapi-url"
    },
    {
     "$ref": "#/components/parameters/okapi-user"
    },
    {
     "in": "path",
     "name": "id",
     "required": true,
     "description": "Settings entry identifier",
     "schema": {
      "type": "string",
      "format": "uuid"
     }
    }
   ],
   "get": {
    "description": "Get setting. If X-Okapi-Permissions includes mod-settings.global.read.SCOPE, then a setting without a userId may be retrieved. If X-Okapi-Permissions includes mod-settings.users.read.SCOPE, then a setting with a userId may be retrieved. If X-Okapi-Permissions includes mod-settings.owner.read.SCOPE, then a setting with userId = current-user may be retrieved.\n",
    "operationId": "getSetting",
    "responses": {
     "200": {
      "description": "Configuration entry",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/entry"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "403": {
      "$ref": "#/components/responses/trait_403"
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "put": {
    "description": "Update setting. If X-Okapi-Permissions includes mod-settings.global.write.SCOPE, then a setting without a userId may be updated. If X-Okapi-Permissions includes mod-settings.users.write.SCOPE, then a setting with a userId may be updated. If X-Okapi-Permissions includes mod-settings.owner.write.SCOPE, then a setting with userId = current-user may be updated.\n",
    "operationId": "putSetting",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/entry"
       }
      }
     }
    },
    "responses": {
     "204": {
      "description": "Setting updated"
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "403": {
      "$ref": "#/components/responses/trait_403"
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "413": {
      "$ref": "#/components/responses/trait_413"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   },
   "delete": {
    "description": "Delete setting. If X-Okapi-Permissions includes mod-settings.global.write.SCOPE, then a setting without a userId may be deleted. If X-Okapi-Permissions includes mod-settings.users.write.SCOPE, then a setting with a userId may be deleted. If X-Okapi-Permissions includes mod-settings.owner.write.SCOPE, then a setting with userId = current-user may be deleted.\n",
    "operationId": "deleteSetting",
    "responses": {
     "204": {
      "description": "Setting deleted"
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "404": {
      "$ref": "#/components/responses/trait_404"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  },
  "/settings/upload": {
   "parameters": [
    {
     "$ref": "#/components/parameters/okapi-permissions"
    },
    {
     "$ref": "#/components/parameters/okapi-tenant"
    },
    {
     "$ref": "#/components/parameters/okapi-token"
    },
    {
     "$ref": "#/components/parameters/okapi-url"
    },
    {
     "$ref": "#/components/parameters/okapi-user"
    }
   ],
   "put": {
    "description": "Upload settings. The entries are inserted or updated depending on whether key, scope, userId already. Each entry gets a unique identifier assigned if it's a new setting. The id must not be supplied. If X-Okapi-Permissions includes mod-settings.global.write.SCOPE, then a setting without a userId may be created/updated. If X-Okapi-Permissions includes mod-settings.users.write.SCOPE, then a setting with a userId may be created/updated. If X-Okapi-Permissions includes mod-settings.owner.write.SCOPE, then a setting with userId = current-user may be created/updated.\n",
    "operationId": "uploadSettings",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/uploadRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Settings uploaded",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/uploadResponse"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/trait_400"
     },
     "403": {
      "$ref": "#/components/responses/trait_403"
     },
     "500": {
      "$ref": "#/components/responses/trait_500"
     }
    }
   }
  }
 },
 "components": {
  "responses": {
   "trait_400": {
    "description": "Bad request",
    "content": {
     "text/plain": {
      "schema": {
       "type": "string",
       "example": "Invalid JSON in request"
      }
     },
     "application/json": {
      "schema": {
       "type": "object",
       "example": {
        "error": "Invalid JSON in request"
       }
      }
     }
    }
   },
   "trait_403": {
    "description": "Forbidden",
    "content": {
     "text/plain": {
      "schema": {
       "type": "string",
       "example": "Insufficient permissions to access resource"
      }
     },
     "application/json": {
      "schema": {
       "type": "object",
       "example": {
        "error": "Insufficient permissions to access resource"
       }
      }
     }
    }
   },
   "trait_404": {
    "description": "Not Found",
    "content": {
     "text/plain": {
      "schema": {
       "type": "string",
       "example": "Identifier 596d9f60-cda3-44d2-a4a1-2f48b7d4d23c not found"
      }
     },
     "application/json": {
      "schema": {
       "type": "object",
       "example": {
        "error": "Identifier 596d9f60-cda3-44d2-a4a1-2f48b7d4d23c not found"
       }
      }
     }
    }
   },
   "trait_413": {
    "description": "Payload Too Large",
    "content": {
     "text/plain": {
      "schema": {
       "type": "string"
      }
     }
    }
   },
   "trait_500": {
    "description": "Internal error",
    "content": {
     "text/plain": {
      "schema": {
       "type": "string",
       "example": "Internal server error, contact administrator"
      }
     }
    }
   }
  },
  "schemas": {
   "errors": {
    "description": "A set of errors",
    "type": "object",
    "properties": {
     "errors": {
      "description": "List of errors",
      "type": "array",
      "items": {
       "type": "object",
       "$ref": "#/components/schemas/error"
      }
     },
     "total_records": {
      "description": "Total number of errors",
      "type": "integer"
     }
    },
    "additionalProperties": false
   },
   "baseUrl": {
    "description": "List of key/value parameters of an error",
    "type": "object",
    "properties": {
     "baseUrl": {
      "description": "Front-end user interface URL without tailing slash",
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "baseUrl"
    ]
   },
   "locale": {
    "description": "List of key/value parameters of an error",
    "type": "object",
    "properties": {
     "locale": {
      "description": "The locale for language display, date format, etc., for example 'en-US' or 'sv' or 'es-419'",
      "type": "string"
     },
     "currency": {
      "description": "Primary currency, for example USD, EUR, INR",
      "type": "string"
     },
     "timezone": {
      "description": "The time zone when showing date time information, for example 'UTC', 'America/New_York'",
      "type": "string"
     },
     "numberingSystem": {
      "description": "The system used for numeral display, either latn or arab",
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "locale",
     "currency",
     "timezone"
    ]
   },
   "metadata": {
    "description": "Metadata containing user and date information",
    "type": "object",
    "properties": {
     "createdByUserId": {
      "description": "Created by user id",
      "type": "string",
      "format": "uuid"
     },
     "createdDate": {
      "description": "Creation date",
      "type": "string"
     },
     "updatedByUserId": {
      "description": "Updated by user id",
      "type": "string",
      "format": "uuid"
     },
     "updatedDate": {
      "description": "Update date",
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "createdDate"
    ]
   },
   "tenantAddress": {
    "description": "Tenant address entry",
    "type": "object",
    "properties": {
     "id": {
      "description": "Identifier",
      "type": "string",
      "format": "uuid"
     },
     "name": {
      "description": "Display name for the address",
      "type": "string"
     },
     "address": {
      "description": "Address text",
      "type": "string"
     },
     "metadata": {
      "type": "object",
      "description": "Metadata containing user and date information",
      "$ref": "#/components/schemas/metadata"
     }
    },
    "additionalProperties": false,
    "required": [
     "name",
     "address"
    ]
   },
   "tenantAddresses": {
    "description": "Tenant addresses",
    "type": "object",
    "properties": {
     "addresses": {
      "type": "array",
      "description": "List of tenant addresses",
      "items": {
       "$ref": "#/components/schemas/tenantAddress"
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "addresses"
    ]
   },
   "entry": {
    "description": "Setting",
    "type": "object",
    "properties": {
     "id": {
      "description": "Identifier",
      "type": "string",
      "format": "uuid"
     },
     "scope": {
      "type": "string",
      "description": "Scope for this entry (normally a module)"
     },
     "key": {
      "type": "string",
      "description": "Key within scope for this setting"
     },
     "value": {
      "description": "Settings value (any type)"
     },
     "userId": {
      "type": "string",
      "format": "uuid",
      "description": "Owner of this setting (optional)"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "scope",
     "key",
     "value"
    ]
   },
   "resultInfo": {
    "description": "Common result set information for streaming response",
    "type": "object",
    "properties": {
     "totalRecords": {
      "description": "Total number of entries in response",
      "type": "integer"
     },
     "diagnostics": {
      "description": "Diagnostics for response",
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "message": {
         "description": "single diagnostic message",
         "type": "string"
        }
       }
      }
     },
     "facets": {
      "type": "array",
      "description": "Array of facets",
      "items": {
       "type": "object",
       "description": "A facet",
       "properties": {
        "facetValues": {
         "type": "array",
         "description": "Array of facet values",
         "items": {
          "type": "object",
          "description": "A facet value",
          "properties": {
           "count": {
            "type": "integer",
            "description": "Count of facet values"
           },
           "value": {
            "description": "Value Object"
           }
          }
         }
        },
        "type": {
         "type": "string",
         "description": "Type of facet"
        }
       }
      }
     }
    },
    "additionalProperties": false
   },
   "entries": {
    "description": "Setting entries response",
    "type": "object",
    "properties": {
     "items": {
      "description": "List of settings",
      "type": "array",
      "items": {
       "type": "object",
       "$ref": "#/components/schemas/entry"
      }
     },
     "resultInfo": {
      "description": "Common result set information",
      "type": "object",
      "$ref": "#/components/schemas/resultInfo"
     }
    },
    "additionalProperties": false,
    "required": [
     "items"
    ]
   },
   "uploadRequest": {
    "description": "Settings upload request body",
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "scope": {
       "type": "string",
       "description": "Scope for this entry (normally a module)"
      },
      "key": {
       "type": "string",
       "description": "Key within scope for this setting"
      },
      "value": {
       "description": "Settings value (any type)"
      },
      "userId": {
       "type": "string",
       "format": "uuid",
       "description": "Owner of this setting (optional)"
      }
     },
     "additionalProperties": false,
     "required": [
      "scope",
      "key",
      "value"
     ]
    }
   },
   "uploadResponse": {
    "description": "Upload response",
    "type": "object",
    "properties": {
     "inserted": {
      "type": "integer",
      "description": "Number of settings inserted"
     },
     "updated": {
      "type": "integer",
      "description": "Number of settings updated"
     }
    },
    "additionalProperties": true,
    "required": [
     "inserted",
     "updated"
    ]
   },
   "parameter": {
    "description": "List of key/value parameters of an error",
    "type": "object",
    "properties": {
     "key": {
      "description": "The key for this parameter",
      "type": "string"
     },
     "value": {
      "description": "The value of this parameter",
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "key"
    ]
   },
   "parameters": {
    "description": "List of key/value parameters of an error",
    "type": "array",
    "items": {
     "type": "object",
     "$ref": "#/components/schemas/parameter"
    },
    "additionalProperties": false
   },
   "error": {
    "description": "An error",
    "type": "object",
    "properties": {
     "message": {
      "type": "string",
      "description": "Error message text"
     },
     "type": {
      "type": "string",
      "description": "Error message type"
     },
     "code": {
      "type": "string",
      "description": "Error message code"
     },
     "parameters": {
      "type": "object",
      "description": "Error message parameters",
      "$ref": "#/components/schemas/parameters"
     }
