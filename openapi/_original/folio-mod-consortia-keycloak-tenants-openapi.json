{
 "openapi": "3.0.0",
 "info": {
  "title": "Tenant integration API",
  "description": "Tenant integration API",
  "version": "0.0.1"
 },
 "servers": [
  {
   "url": "/consortia/{consortiumId}/"
  }
 ],
 "paths": {
  "/tenants": {
   "get": {
    "summary": "Get a list of tenants based on consortiumId",
    "operationId": "getTenants",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/trait_pageable_offset"
     },
     {
      "$ref": "#/components/parameters/trait_pageable_limit"
     }
    ],
    "responses": {
     "200": {
      "$ref": "#/components/responses/TenantCollection"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   },
   "post": {
    "summary": "Save tenant",
    "operationId": "saveTenant",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/adminUserId"
     }
    ],
    "requestBody": {
     "$ref": "#/components/requestBodies/TenantBody"
    },
    "responses": {
     "201": {
      "$ref": "#/components/responses/Tenant"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "$ref": "#/components/responses/Conflict"
     },
     "422": {
      "$ref": "#/components/responses/Conflict"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   }
  },
  "/tenants/{tenantId}": {
   "put": {
    "summary": "Update tenant name",
    "operationId": "updateTenant",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "requestBody": {
     "$ref": "#/components/requestBodies/TenantBody"
    },
    "responses": {
     "200": {
      "$ref": "#/components/responses/Tenant"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   },
   "delete": {
    "summary": "Delete tenant by Id",
    "operationId": "deleteTenantById",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "requestBody": {
     "$ref": "#/components/requestBodies/TenantDeleteRequest"
    },
    "responses": {
     "204": {
      "$ref": "#/components/responses/NoContent"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   },
   "get": {
    "summary": "Get tenant details by Id",
    "operationId": "getTenantDetailsById",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "responses": {
     "200": {
      "$ref": "#/components/responses/TenantDetails"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   }
  },
  "/tenants/{tenantId}/sync-primary-affiliations": {
   "post": {
    "summary": "Sync Primary Affiliations",
    "operationId": "syncPrimaryAffiliations",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     },
     {
      "$ref": "#/components/parameters/centralTenantId"
     }
    ],
    "responses": {
     "201": {
      "$ref": "#/components/responses/NoContent"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "$ref": "#/components/responses/Conflict"
     },
     "422": {
      "$ref": "#/components/responses/Conflict"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   }
  },
  "/tenants/{tenantId}/create-primary-affiliations": {
   "post": {
    "summary": "Create Primary Affiliations",
    "operationId": "createPrimaryAffiliations",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     },
     {
      "$ref": "#/components/parameters/centralTenantId"
     }
    ],
    "requestBody": {
     "$ref": "#/components/requestBodies/SyncPrimaryAffiliationsRequest"
    },
    "responses": {
     "201": {
      "$ref": "#/components/responses/NoContent"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "$ref": "#/components/responses/Conflict"
     },
     "422": {
      "$ref": "#/components/responses/Conflict"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   }
  },
  "/tenants/{tenantId}/identity-provider": {
   "post": {
    "summary": "Create keycloak identity provider for member tenant in central tenant realm",
    "operationId": "createIdentityProvider",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "requestBody": {
     "$ref": "#/components/requestBodies/IdentityProviderCreateRequest"
    },
    "responses": {
     "201": {
      "$ref": "#/components/responses/Created"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   },
   "delete": {
    "summary": "Delete keycloak identity provider of member tenant from central tenant realm",
    "operationId": "deleteIdentityProvider",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "responses": {
     "204": {
      "$ref": "#/components/responses/NoContent"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   }
  },
  "/tenants/{tenantId}/custom-login": {
   "post": {
    "summary": "Set up custom keycloak login flow for central tenant",
    "operationId": "setupCustomLogin",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "responses": {
     "201": {
      "$ref": "#/components/responses/Created"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   },
   "delete": {
    "summary": "Remove custom keycloak login flow of central tenant and restore built-in browser flow",
    "operationId": "deleteCustomLogin",
    "parameters": [
     {
      "$ref": "#/components/parameters/consortiumId"
     },
     {
      "$ref": "#/components/parameters/tenantId"
     }
    ],
    "responses": {
     "204": {
      "$ref": "#/components/responses/NoContent"
     },
     "400": {
      "$ref": "#/components/responses/BadRequest"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "500": {
      "$ref": "#/components/responses/InternalServerError"
     }
    }
   }
  }
 },
 "components": {
  "requestBodies": {
   "TenantBody": {
    "description": "Tenant object",
    "required": true,
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Tenant"
      }
     }
    }
   },
   "SyncPrimaryAffiliationsRequest": {
    "description": "SyncPrimaryAffiliationsRequest object",
    "required": true,
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/SyncPrimaryAffiliationBody"
      }
     }
    }
   },
   "IdentityProviderCreateRequest": {
    "description": "IdentityProviderCreateRequest object",
    "required": true,
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/IdentityProviderCreateRequest"
      }
     }
    }
   },
   "TenantDeleteRequest": {
    "description": "Deletes tenant based on delete options",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/TenantDeleteRequest"
      }
     }
    }
   },
   "UsersIdpLinkOperationRequest": {
    "description": "Users IDP link operation request object",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/UsersIdpLinkOperationRequest"
      }
     }
    }
   }
  },
  "responses": {
   "Tenant": {
    "description": "Returns a tenant object",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Tenant"
      }
     }
    }
   },
   "TenantDetails": {
    "description": "Returns a tenant details object",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/TenantDetails"
      }
     }
    }
   },
   "TenantCollection": {
    "description": "Returns a tenant collection object",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/TenantCollection"
      }
     }
    }
   },
   "Created": {
    "description": "Created"
   },
   "NoContent": {
    "description": "No content"
   },
   "Conflict": {
    "description": "Validation errors",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Errors"
      }
     }
    }
   },
   "NotFound": {
    "description": "Resource not found",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Errors"
      }
     }
    }
   },
   "BadRequest": {
    "description": "Bad request",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Errors"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "Not authorized to perform requested action",
    "content": {
     "text/plain": {
      "example": "unable to perform action -- unauthorized"
     }
    }
   },
   "UnprocessableEntity": {
    "description": "Validation errors",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Errors"
      }
     }
    }
   },
   "InternalServerError": {
    "description": "Internal server error",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  },
  "parameters": {
   "consortiumId": {
    "in": "path",
    "name": "consortiumId",
    "schema": {
     "$ref": "#/components/schemas/uuid"
    },
    "required": true,
    "description": "The ID of consortium"
   },
   "adminUserId": {
    "in": "query",
    "name": "adminUserId",
    "schema": {
     "$ref": "#/components/schemas/uuid"
    },
    "description": "The ID of adminUser"
   },
   "tenantId": {
    "in": "path",
    "name": "tenantId",
    "schema": {
     "type": "string"
    },
    "required": true,
    "description": "The ID of the tenant"
   },
   "centralTenantId": {
    "in": "query",
    "name": "centralTenantId",
    "schema": {
     "type": "string"
    },
    "required": true,
    "description": "The ID of the central tenant"
   },
   "trait_pageable_offset": {
    "name": "offset",
    "in": "query",
    "description": "Skip over a number of elements by specifying an offset value for the query",
    "schema": {
     "default": 0,
     "minimum": 0,
     "maximum": 2147483647,
     "type": "integer"
    }
   },
   "trait_pageable_limit": {
    "name": "limit",
    "in": "query",
    "description": "Limit the number of elements returned in the response",
    "schema": {
     "default": 100,
     "minimum": 0,
     "maximum": 2147483647,
     "type": "integer"
    }
   }
  },
  "schemas": {
   "uuid": {
    "type": "string",
    "format": "uuid"
   },
   "Tenant": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 5,
      "pattern": "^[a-zA-Z0-9]*$"
     },
     "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 150
     },
     "isCentral": {
      "type": "boolean"
     },
     "isDeleted": {
      "type": "boolean"
     }
    },
    "additionalProperties": false,
    "required": [
     "id",
     "code",
     "name",
     "isCentral"
    ]
   },
   "TenantCollection": {
    "type": "object",
    "properties": {
     "tenants": {
      "type": "array",
      "description": "Tenants",
      "items": {
       "type": "object",
       "$ref": "#/components/schemas/Tenant"
      }
     },
     "totalRecords": {
      "type": "integer"
     }
    },
    "additionalProperties": false,
    "required": [
     "tenants",
     "totalRecords"
    ]
   },
   "Parameter": {
    "description": "List of key/value parameters of an error",
    "type": "object",
    "properties": {
     "key": {
      "type": "string",
      "minLength": 1
     },
     "value": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "key"
    ]
   },
   "Parameters": {
    "description": "List of key/value parameters of an error",
    "type": "array",
    "items": {
     "$ref": "#/components/schemas/Parameter"
    },
    "additionalProperties": false
   },
   "Error": {
    "description": "An error",
    "type": "object",
    "properties": {
     "message": {
      "type": "string",
      "minLength": 1,
      "description": "Error message text"
     },
     "type": {
      "type": "string",
      "description": "Error message type"
     },
     "code": {
      "type": "string",
      "description": "Error message code"
     },
     "parameters": {
      "description": "Error message parameters",
      "$ref": "#/components/schemas/Parameters"
     }
    },
    "additionalProperties": false,
    "required": [
     "message"
    ]
   },
   "Errors": {
    "description": "A set of errors",
    "type": "object",
    "properties": {
     "errors": {
      "description": "List of errors",
      "type": "array",
      "items": {
       "type": "object",
       "$ref": "#/components/schemas/Error"
      }
     },
     "total_records": {
      "description": "Total number of errors",
      "type": "integer"
     }
    },
    "additionalProperties": false
   },
   "TenantDetails": {
    "allOf": [
     {
      "$ref": "#/components/schemas/Tenant"
     },
     {
      "type": "object",
      "properties": {
       "setupStatus": {
        "type": "string",
        "enum": [
         "IN_PROGRESS",
         "COMPLETED",
         "COMPLETED_WITH_ERRORS",
         "FAILED"
        ]
       }
      }
     }
    ]
   },
   "TenantDeleteRequest": {
    "type": "object",
    "properties": {
     "deleteType": {
      "type": "string",
      "enum": [
       "HARD",
       "SOFT"
      ]
     },
     "deleteOptions": {
      "type": "object",
      "properties": {
       "deleteUsersUserTenants": {
        "type": "boolean",
        "default": false
       },
       "deleteRelatedShadowUsers": {
        "type": "boolean",
        "default": false
       }
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "deleteType",
     "deleteOptions"
    ]
   },
   "SyncUser": {
    "description": "Users item",
    "type": "object",
    "properties": {
     "id": {
      "description": "User id",
      "type": "string"
     },
     "username": {
      "description": "The name of the user",
      "type": "string"
     },
     "email": {
      "description": "The email of the user",
      "type": "string"
     },
     "mobilePhoneNumber": {
      "description": "The mobile phone number of the user",
      "type": "string"
     },
     "phoneNumber": {
      "description": "The phone number of the user",
      "type": "string"
     },
     "externalSystemId": {
      "description": "External system id of user",
      "type": "string"
     },
     "barcode": {
      "description": "The user's barcode",
      "type": "string"
     }
    },
    "additionalProperties": false
   },
   "SyncPrimaryAffiliationBody": {
    "description": "Primary affiliation DTO",
    "type": "object",
    "properties": {
     "tenantId": {
      "description": "Unique tenant id",
      "type": "string"
     },
     "users": {
      "description": "users",
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/SyncUser"
      }
     }
    },
    "additionalProperties": false,
    "required": [
     "tenantId"
    ]
   },
   "IdentityProviderCreateRequest": {
    "type": "object",
    "properties": {
     "createProvider": {
      "type": "boolean",
      "default": true
     },
     "migrateUsers": {
      "type": "boolean",
      "default": true
     },
     "baseUrl": {
      "type": "string",
      "description": "Keycloak base URL to build identity provider URLs with (e.g. https://keycloak.example.org). Overrides KC_IDENTITY_PROVIDER_BASE_URL if provided",
      "pattern": "^(\\s*|https?://.+)$"
     }
    },
    "additionalProperties": false,
    "required": [
     "createProvider",
     "migrateUsers"
    ]
   },
   "UsersIdpLinkOperationRequest": {
    "type": "object",
    "properties": {
     "userIds": {
      "type": "array",
      "description": "A list of user UUIDs that are to be scheduled for IDP linking in central tenant",
      "uniqueItems": true,
      "items": {
       "type": "string",
       "description": "A globally unique (UUID) identifier for the user"
      }
     },
     "centralTenantId": {
      "type": "string",
      "description": "Central tenant id that will be used for linking the shadow users"
     }
    },
    "additionalProperties": false,
    "required": [
     "userIds",
     "centralTenantId"
    ]
   }
  }
 }
}